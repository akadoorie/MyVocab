// Cloudflare Worker "myvocab": serves the SPA assets and /api/* (PRD §16).
// No real ids or secrets are committed. Production values are set by the owner (PRD §19).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "myvocab",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets: the built React SPA. Only /api/* runs the Worker first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // D1 (PRD §11): the production database "myvocab-prod" (region WEUR). The id isn't a secret;
  // local development and tests use local copies keyed by this id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myvocab-prod",
      "database_id": "c5805b60-82e9-4bac-bc5a-401690221579",
      "migrations_dir": "migrations",
    },
  ],

  // Burst limits per minute (PRD §14.3), one binding per rule. Hourly/daily caps live in D1
  // usage_counters. No D1 writes are involved.
  "ratelimits": [
    { "name": "RL_PRACTICES", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AVAILABLE", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_IMPORT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
  ],

  // Hourly: Trash purge + usage counter cleanup (PRD §7.3, §11.1).
  "triggers": { "crons": ["0 * * * *"] },

  // Non-secret configuration for PRODUCTION (the owner fills these in, PRD §19). The defaults fail
  // closed: production refuses to serve until Access, https APP_URL etc. are configured.
  // Local development overrides them in .dev.vars (git-ignored; see .dev.vars.example), tests in
  // vitest.config.ts and scripts/e2e-server.mjs. Secrets: `wrangler secret put` (PRD §16).
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://myvocab.akadoorie.workers.dev",
    "CF_ACCESS_TEAM_DOMAIN": "myvocab.cloudflareaccess.com",
    "CF_ACCESS_AUD": "3c55a3d4d48afb9515c0860c62861f67dcc8928d22241da5a0069d5559ef77e2",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGFj7AM8TqFNelyK",
  },

  "observability": { "enabled": true },
}
