// Cloudflare Worker "myvocab": serves the SPA assets and /api/* (PRD §16).
// No real ids or secrets are committed. Production values are set by the owner (PRD §19).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "myvocab",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets: the built React SPA. Only /api/* runs the Worker first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // D1 (PRD §11). Placeholder id: the owner creates "myvocab-prod" and pastes its id (PRD §19).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myvocab-prod",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Burst limits (PRD §14.3). Hourly/daily caps live in D1 usage_counters.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],

  // Hourly: Trash purge + usage counter cleanup (PRD §7.3, §11.1).
  "triggers": { "crons": ["0 * * * *"] },

  // Non-secret configuration. Secrets go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:5173",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000BB",
  },

  "observability": { "enabled": true },
}
