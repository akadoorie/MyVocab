{
  "name": "@myvocab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-assets-dir.mjs && pnpm db:migrate:local && wrangler dev --port 8787",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/ensure-assets-dir.mjs && vitest run",
    "db:migrate:local": "wrangler d1 migrations apply myvocab-prod --local",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:export": "tsx scripts/export.ts",
    "db:update-translations": "tsx scripts/update-translations.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts"
  },
  "dependencies": {
    "@myvocab/contracts": "workspace:*",
    "@myvocab/core": "workspace:*",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.0"
  }
}
